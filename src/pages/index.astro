---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
			.hero {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				gap: 22px;
				padding: 48px 32px 56px;
			}
			.hero-sun {
				width: 210px;
			}
			.hero-sun img {
				display: block;
				width: 100%;
				height: auto;
			}
			.hero h1 {
				max-width: 14ch;
				margin: 0;
			}
			.hero .sub {
				font-size: 1.1rem;
				line-height: 1.7;
				color: rgb(var(--gray-dark));
				max-width: 44ch;
				margin: 0;
			}
			.hero .cta {
				margin-top: 4px;
				display: inline-flex;
				padding: 13px 30px;
				background: var(--accent);
				color: #fff;
				border-radius: 30px;
				font-weight: 700;
				font-size: 0.95rem;
				text-decoration: none;
			}
			.hero .cta:hover {
				background: var(--accent-dark);
			}
			.horizon {
				margin-top: 8px;
			}
			.horizon svg {
				display: block;
				width: 100%;
				height: auto;
			}
			.strip {
				background: var(--accent-dark);
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				align-items: end;
				margin-top: -1px;
			}
			.strip .item {
				position: relative;
				padding: 32px 24px 38px;
				text-align: center;
				border-right: 1px solid rgba(246, 239, 229, 0.18);
				cursor: pointer;
				background: var(--accent-dark);
				transition: transform 0.35s ease;
			}
			.strip .item:last-child {
				border-right: none;
			}
			.strip .item:hover,
			.strip .item.expanded {
				transform: translateY(-56px);
				z-index: 2;
			}
			.strip .item:focus-visible {
				outline: 2px solid rgb(var(--desert-cream));
				outline-offset: -4px;
			}
			.strip .item .k {
				font-family: "Lo-Type", serif;
				font-weight: 400;
				font-size: 1.1rem;
				color: rgb(var(--desert-cream));
				margin-bottom: 5px;
			}
			.strip .item .v {
				font-size: 0.85rem;
				color: rgba(246, 239, 229, 0.78);
			}
			.strip .item .detail {
				max-height: 0;
				overflow: hidden;
				opacity: 0;
				font-size: 0.85rem;
				line-height: 1.6;
				color: rgba(246, 239, 229, 0.9);
				transition: max-height 0.35s ease, opacity 0.3s ease, margin-top 0.35s ease;
			}
			.strip .item:hover .detail,
			.strip .item.expanded .detail {
				max-height: 200px;
				opacity: 1;
				margin-top: 12px;
			}
			@media (max-width: 720px) {
				.hero {
					padding: 36px 20px 44px;
				}
				.hero-sun {
					width: 150px;
				}
				.strip {
					grid-template-columns: 1fr;
				}
				.strip .item {
					border-right: none;
					border-top: 1px solid rgba(246, 239, 229, 0.18);
					padding: 18px 22px;
				}
				.strip .item:first-child {
					border-top: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<div class="hero-sun"><img src="/images/brand/srb-medallion.png" alt="Sonoran Rise Bakery" /></div>
				<h1>Bread worth slowing down for.</h1>
				<p class="sub">
					Naturally leavened sourdough, milled fresh and shaped by hand &mdash; inspired by the patience of the
					Sonoran Desert.
				</p>
				<a class="cta" href="/join">Join the Rise</a>
			</div>

			<div class="horizon">
				<svg viewBox="0 0 800 130" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
					<polygon
						points="0,130 0,70 70,55 150,72 230,48 320,68 400,42 480,64 570,46 650,66 730,50 800,60 800,130"
						fill="var(--mesa-light)"
						opacity="0.55"
					></polygon>
					<polygon
						points="0,130 0,95 90,80 180,98 270,76 350,92 440,70 530,90 620,74 710,92 800,80 800,130"
						fill="var(--accent-dark)"
					></polygon>
				</svg>
			</div>

			<div class="strip" id="ingredient-strip">
				<div class="item" tabindex="0" role="button" aria-expanded="false">
					<div class="k">Flour</div>
					<div class="v">Heritage &amp; regional grain</div>
					<p class="detail">
						We seek out heritage wheats that carry the story of the region, and mill fresh rather than let
						flour sit and lose its character.
					</p>
				</div>
				<div class="item" tabindex="0" role="button" aria-expanded="false">
					<div class="k">Water</div>
					<div class="v">Long, slow fermentation</div>
					<p class="detail">
						Dough ferments for days, not hours. Time develops the flavor, the crumb, and the crust that
						shortcuts can't fake.
					</p>
				</div>
				<div class="item" tabindex="0" role="button" aria-expanded="false">
					<div class="k">Salt &amp; Starter</div>
					<div class="v">Nothing else needed</div>
					<p class="detail">
						A natural starter we feed by hand, and just enough salt. That's the whole list, on purpose.
					</p>
				</div>
			</div>

		</main>
		<Footer />
		<script>
			const items = document.querySelectorAll<HTMLElement>('#ingredient-strip .item');

			function toggle(item: HTMLElement) {
				const expanded = item.classList.toggle('expanded');
				item.setAttribute('aria-expanded', String(expanded));
				items.forEach((other) => {
					if (other !== item) {
						other.classList.remove('expanded');
						other.setAttribute('aria-expanded', 'false');
					}
				});
			}

			function close(item: HTMLElement) {
				item.classList.remove('expanded');
				item.setAttribute('aria-expanded', 'false');
			}

			items.forEach((item) => {
				item.addEventListener('click', () => toggle(item));
				item.addEventListener('keydown', (e) => {
					if (e.key === 'Enter' || e.key === ' ') {
						e.preventDefault();
						toggle(item);
					}
				});
				// A click (touch, or a stray mouse click while hovering) can leave
				// .expanded set after the pointer moves away; hover alone would
				// otherwise revert fine, so reset explicitly on mouseleave/blur.
				item.addEventListener('mouseleave', () => close(item));
				item.addEventListener('blur', () => close(item));
			});
		</script>
	</body>
</html>
