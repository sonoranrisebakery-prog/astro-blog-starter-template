---
// MailerLite embedded form (form id 192604569655576215, account 2494870).
// Submitted via our own fetch handler below, not MailerLite's webforms.min.js —
// that script was supposed to intercept the submit and swap in the success
// message, but on this page it wasn't reliably taking over, so the browser
// fell back to a plain form-post that landed visitors on the raw JSON API
// response in a new tab. This avoids depending on that script at all.
---

<div id="mlb2-43601852" class="newsletter-signup">
	<div class="row-form">
		<p class="newsletter-copy">
			Follow our journey from freshly milled grain to the first Sonoran Rise loaves. Get updates
			on product development, launch progress, and availability.
		</p>

		<form class="newsletter-form" id="newsletter-form">
			<div class="newsletter-row">
				<label class="sr-only" for="newsletter-email">Email</label>
				<input
					id="newsletter-email"
					type="email"
					name="fields[email]"
					placeholder="Email"
					autocomplete="email"
					required
				/>
				<button type="submit">Subscribe</button>
			</div>

			<label class="newsletter-checkbox">
				<input type="checkbox" required />
				<span>Opt in to receive news and updates.</span>
			</label>
		</form>

		<p class="newsletter-error" id="newsletter-error" style="display: none">
			Something went wrong — mind trying again?
		</p>
	</div>

	<div class="row-success" style="display: none">
		<h4>Thank you!</h4>
		<p>You have successfully joined our subscriber list.</p>
	</div>
</div>

<style>
	.newsletter-signup {
		max-width: 480px;
		margin: 2em 0;
	}
	.newsletter-copy {
		margin-bottom: 1em;
	}
	.newsletter-row {
		display: flex;
		gap: 0.5em;
	}
	.newsletter-row input[type='email'] {
		flex: 1;
		padding: 0.6em 0.75em;
		border: 1px solid rgb(var(--gray));
		border-radius: 4px;
		font-family: inherit;
		font-size: 16px;
	}
	.newsletter-row button[type='submit'] {
		padding: 0.6em 1.25em;
		background-color: var(--accent);
		color: #fff;
		border: none;
		border-radius: 4px;
		font-family: inherit;
		font-weight: 700;
		cursor: pointer;
	}
	.newsletter-row button[type='submit']:hover {
		background-color: var(--accent-dark);
	}
	.newsletter-checkbox {
		display: flex;
		align-items: flex-start;
		gap: 0.5em;
		margin-top: 0.75em;
		font-size: 0.85em;
		color: rgb(var(--gray-dark));
	}
	.newsletter-checkbox input {
		margin-top: 0.2em;
	}
	.row-success h4 {
		margin-bottom: 0.25em;
	}
	.newsletter-error {
		margin-top: 0.5em;
		font-size: 0.85em;
		color: var(--accent-dark);
	}
	@media (max-width: 480px) {
		.newsletter-row {
			flex-direction: column;
		}
	}
</style>

<script>
	const form = document.getElementById('newsletter-form') as HTMLFormElement;
	const errorEl = document.getElementById('newsletter-error') as HTMLElement;

	form.addEventListener('submit', (event) => {
		event.preventDefault();
		const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
		const email = (document.getElementById('newsletter-email') as HTMLInputElement).value;
		errorEl.style.display = 'none';
		button.disabled = true;
		button.textContent = 'Sending…';

		const body = new URLSearchParams({
			'fields[email]': email,
			'ml-submit': '1',
			anticsrf: 'true',
		});

		fetch('https://assets.mailerlite.com/jsonp/2494870/forms/192604569655576215/subscribe', {
			method: 'POST',
			mode: 'no-cors',
			headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
			body: body.toString(),
		})
			.then(() => {
				document.querySelectorAll('#mlb2-43601852 .row-success').forEach((el) => {
					(el as HTMLElement).style.display = '';
				});
				document.querySelectorAll('#mlb2-43601852 .row-form').forEach((el) => {
					(el as HTMLElement).style.display = 'none';
				});
			})
			.catch(() => {
				button.disabled = false;
				button.textContent = 'Subscribe';
				errorEl.style.display = 'block';
			});
	});
</script>
