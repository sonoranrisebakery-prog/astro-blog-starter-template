---
---

<header>
	<nav>
		<h2><a href="/">
			<img src="/images/brand/srb-horizontal.png" alt="Sonoran Rise Bakery" class="logo" />
		</a></h2>
		<div class="internal-links">
			<a href="/story">Story</a>
			<a href="/bread">Bread</a>
			<a href="/journal">Journal</a>
			<a href="/join">Join</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background-color: rgb(var(--desert-cream));
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.6em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-size: 1.35rem;
		font-weight: 700;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	@media (max-width: 600px) {
		nav a {
			font-size: 1rem;
			padding: 1em 0.4em;
		}
	}
</style>
